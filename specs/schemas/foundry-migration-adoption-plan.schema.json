{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.local/foundry/foundry-migration-adoption-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace_id",
    "plan_sha256",
    "actor_id",
    "runtime_manifest_sha256",
    "selections",
    "tasks",
    "remote_write_allowed",
    "adoption_sha256"
  ],
  "properties": {
    "schema": {
      "const": "tiangong-foundry.migration-adoption-plan.v1"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$"
    },
    "runtime_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selections": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_task", "spec_file"],
        "properties": {
          "source_task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "spec_file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authority",
          "source_spec",
          "target_spec",
          "inputs",
          "evidence_paths",
          "scope_inputs",
          "reasons"
        ],
        "properties": {
          "authority": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_task",
              "origin_sha256",
              "disposition",
              "task_id",
              "request_id",
              "actor_id",
              "spec_fingerprint_sha256",
              "scope_keys",
              "scope_complete"
            ],
            "properties": {
              "source_task": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8192
              },
              "origin_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "disposition": {
                "enum": [
                  "local-unattempted",
                  "terminal-retained",
                  "owner-readback-only",
                  "blocked-evidence"
                ]
              },
              "task_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^task-[0-9a-f]{64}-r[0-9]{4}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "request_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actor_id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$"
              },
              "spec_fingerprint_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "scope_keys": {
                "type": "array",
                "maxItems": 100000,
                "items": {
                  "type": "string",
                  "pattern": "^(?:contact|source|flow|flowproperty|unitgroup|process|lifecyclemodel):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
                },
                "uniqueItems": true
              },
              "scope_complete": {
                "type": "boolean"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "disposition": {
                      "const": "local-unattempted"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "task_id": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "spec_fingerprint_sha256": {
                      "type": "string"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "task_id": {
                      "type": "null"
                    },
                    "request_id": {
                      "type": "null"
                    },
                    "spec_fingerprint_sha256": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "scope_complete": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "scope_keys": {
                      "minItems": 1,
                      "type": "array"
                    }
                  }
                }
              }
            ]
          },
          "source_spec": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "bytes", "sha256"],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 67108864
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "target_spec": {
            "anyOf": [
              {
                "$ref": "#/$defs/taskSpec"
              },
              {
                "type": "null"
              }
            ]
          },
          "inputs": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "bytes", "sha256"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 67108864
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "evidence_paths": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^:]+$"
            }
          },
          "scope_inputs": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^:]+$"
            }
          },
          "reasons": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "authority": {
                  "properties": {
                    "disposition": {
                      "const": "local-unattempted"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "then": {
              "properties": {
                "source_spec": {
                  "type": "object"
                },
                "target_spec": {
                  "type": "object"
                },
                "inputs": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            },
            "else": {
              "properties": {
                "source_spec": {
                  "type": "null"
                },
                "target_spec": {
                  "type": "null"
                },
                "inputs": {
                  "maxItems": 0,
                  "type": "array"
                }
              }
            }
          }
        ]
      }
    },
    "remote_write_allowed": {
      "const": false
    },
    "adoption_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "taskSpec": {
      "title": "Foundry task-start spec v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "actor_id",
        "lane",
        "profile_id",
        "target_entities",
        "sources",
        "seed",
        "account_intent",
        "preparation"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/taskSpec/$defs/id"
        },
        "actor_id": {
          "$ref": "#/$defs/taskSpec/$defs/id"
        },
        "lane": {
          "enum": ["external-dataset-curated-import", "source-evidence-dataset-development"]
        },
        "profile_id": {
          "$ref": "#/$defs/taskSpec/$defs/id"
        },
        "target_entities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "contact",
              "source",
              "support",
              "flow",
              "flowproperty",
              "unitgroup",
              "process",
              "lifecyclemodel"
            ]
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/taskSpec/$defs/selection"
          }
        },
        "seed": {
          "oneOf": [
            {
              "$ref": "#/$defs/taskSpec/$defs/selection"
            },
            {
              "type": "null"
            }
          ]
        },
        "account_intent": {
          "oneOf": [
            {
              "$ref": "#/$defs/taskSpec/$defs/accountIntent"
            },
            {
              "type": "null"
            }
          ]
        },
        "preparation": {
          "oneOf": [
            {
              "$ref": "#/$defs/taskSpec/$defs/cleanupPreparation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lane": {
                "const": "source-evidence-dataset-development"
              }
            },
            "required": ["lane"]
          },
          "then": {
            "properties": {
              "seed": {
                "$ref": "#/$defs/taskSpec/$defs/selection"
              }
            }
          }
        }
      ],
      "$defs": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        "accountIntent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_ref", "user_id"],
          "properties": {
            "project_ref": {
              "type": "string",
              "pattern": "^[a-z0-9]{20}$"
            },
            "user_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            }
          }
        },
        "cleanupPreparation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "type", "input", "source_input", "output_directory"],
          "properties": {
            "operation": {
              "const": "dataset-curation-cleanup"
            },
            "type": {
              "enum": [
                "contact",
                "source",
                "support",
                "flow",
                "flowproperty",
                "unitgroup",
                "process",
                "lifecyclemodel"
              ]
            },
            "input": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "source_input": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                {
                  "type": "null"
                }
              ]
            },
            "output_directory": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        }
      }
    }
  }
}
