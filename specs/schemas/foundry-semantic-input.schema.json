{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.local/foundry/semantic-input.schema.json",
  "title": "Foundry semantic input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "actor_id", "assessment_sha256", "submissions"],
  "properties": {
    "schema": { "const": "tiangong-foundry.semantic-input.v1" },
    "task_id": { "type": "string", "pattern": "^task-[0-9a-f]{64}-r[0-9]{4}$" },
    "actor_id": { "type": "string", "maxLength": 256, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$" },
    "assessment_sha256": { "$ref": "#/$defs/sha" },
    "submissions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "authoring_task_sha256", "file", "sha256"],
        "properties": {
          "kind": { "const": "patch" },
          "authoring_task_sha256": { "$ref": "#/$defs/sha" },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000\\r\\n]+$"
          },
          "sha256": { "$ref": "#/$defs/sha" }
        }
      }
    }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
