{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.local/foundry/foundry-migration-activation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace_id",
    "plan_sha256",
    "adoption_sha256",
    "created_at_utc",
    "tasks",
    "protected_files",
    "remote_write_allowed",
    "activation_sha256"
  ],
  "properties": {
    "schema": {
      "const": "tiangong-foundry.migration-activation.v1"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adoption_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "tasks": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_task",
          "origin_sha256",
          "disposition",
          "task_id",
          "request_id",
          "actor_id",
          "spec_fingerprint_sha256",
          "scope_keys",
          "scope_complete"
        ],
        "properties": {
          "source_task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "origin_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "disposition": {
            "enum": [
              "local-unattempted",
              "terminal-retained",
              "owner-readback-only",
              "blocked-evidence"
            ]
          },
          "task_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^task-[0-9a-f]{64}-r[0-9]{4}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "actor_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$"
          },
          "spec_fingerprint_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "scope_keys": {
            "type": "array",
            "maxItems": 100000,
            "items": {
              "type": "string",
              "pattern": "^(?:contact|source|flow|flowproperty|unitgroup|process|lifecyclemodel):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}@[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
            },
            "uniqueItems": true
          },
          "scope_complete": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "local-unattempted"
                }
              }
            },
            "then": {
              "properties": {
                "task_id": {
                  "type": "string"
                },
                "request_id": {
                  "type": "string"
                },
                "spec_fingerprint_sha256": {
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "task_id": {
                  "type": "null"
                },
                "request_id": {
                  "type": "null"
                },
                "spec_fingerprint_sha256": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scope_complete": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "scope_keys": {
                  "minItems": 1,
                  "type": "array"
                }
              }
            }
          }
        ]
      }
    },
    "protected_files": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^:]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "remote_write_allowed": {
      "const": false
    },
    "activation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
