{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.local/foundry/facade-request-index.schema.json",
  "title": "Foundry facade request index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace_id",
    "request_id",
    "request_sha256",
    "revisions",
    "index_sha256"
  ],
  "properties": {
    "schema": { "const": "tiangong-foundry.facade-request-index.v1" },
    "workspace_id": { "$ref": "#/$defs/id" },
    "request_id": { "$ref": "#/$defs/id" },
    "request_sha256": { "$ref": "#/$defs/sha256" },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/revision" }
    },
    "index_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "task_id",
        "predecessor_task_id",
        "fingerprint_sha256",
        "spec_source",
        "spec",
        "inputs",
        "created_at_utc",
        "record_sha256"
      ],
      "properties": {
        "revision": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "task_id": { "type": "string", "pattern": "^task-[0-9a-f]{64}-r[0-9]{4}$" },
        "predecessor_task_id": {
          "oneOf": [
            { "type": "string", "pattern": "^task-[0-9a-f]{64}-r[0-9]{4}$" },
            { "type": "null" }
          ]
        },
        "fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "spec_source": { "$ref": "#/$defs/fact" },
        "spec": { "$ref": "https://tiangong-lca.local/foundry/task-start.schema.json" },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/fact" }
        },
        "created_at_utc": { "type": "string" },
        "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
