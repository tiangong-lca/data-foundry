{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.local/foundry/authorization-derivation.schema.json",
  "title": "Foundry authorization derivation evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "parent_authorization_sha256",
    "derived_authorization_sha256",
    "approved_input",
    "derived_input"
  ],
  "properties": {
    "schema": { "const": "tiangong-foundry.authorization-derivation.v1" },
    "parent_authorization_sha256": { "$ref": "#/$defs/sha256" },
    "derived_authorization_sha256": { "$ref": "#/$defs/sha256" },
    "approved_input": { "$ref": "#/$defs/inputFact" },
    "derived_input": { "$ref": "#/$defs/inputFact" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inputFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
