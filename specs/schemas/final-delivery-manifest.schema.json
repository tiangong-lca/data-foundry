{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.dev/schemas/foundry-final-delivery-manifest.v1.json",
  "title": "Foundry Final Delivery Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delivery_id",
    "producer_id",
    "delivery_root",
    "promotion_mode",
    "production_authority",
    "findings",
    "artifacts",
    "algebra",
    "workbooks",
    "redaction",
    "reviewers"
  ],
  "properties": {
    "schema_version": { "const": "foundry-final-delivery-manifest.v1" },
    "delivery_id": { "type": "string", "minLength": 1 },
    "producer_id": { "type": "string", "minLength": 1 },
    "delivery_root": { "$ref": "#/$defs/relativePath" },
    "promotion_mode": { "const": "OFFLINE_ONLY" },
    "production_authority": { "const": false },
    "findings": { "$ref": "#/$defs/zeroFindings" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "algebra": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/algebraAssertion" }
    },
    "workbooks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/workbook" }
    },
    "redaction": { "$ref": "#/$defs/redaction" },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reviewer" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "zeroFindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p0", "p1"],
      "properties": {
        "p0": { "const": 0 },
        "p1": { "const": 0 }
      }
    },
    "rowCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": ["json-object", "json-object-rows", "json-array", "jsonl", "csv", "xlsx", "none"]
        },
        "required_columns": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "bytes", "rows", "schema", "row_count"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 0 },
        "schema": { "type": "string", "minLength": 1 },
        "row_count": { "$ref": "#/$defs/rowCount" }
      }
    },
    "operand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": { "literal": { "type": "number" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_rows"],
          "properties": { "artifact_rows": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_json"],
          "properties": {
            "artifact_json": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact_id", "pointer"],
              "properties": {
                "artifact_id": { "type": "string", "minLength": 1 },
                "pointer": { "type": "string", "pattern": "^(?:$|/)" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sum"],
          "properties": {
            "sum": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/operand" }
            }
          }
        }
      ]
    },
    "algebraAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "left", "operator", "right"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "left": { "$ref": "#/$defs/operand" },
        "operator": { "enum": ["eq", "lte", "gte"] },
        "right": { "$ref": "#/$defs/operand" }
      }
    },
    "requiredCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell", "equals"],
      "properties": {
        "cell": { "type": "string", "pattern": "^[A-Z]+[1-9][0-9]*$" },
        "equals": { "type": ["string", "number", "boolean"] }
      }
    },
    "sheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "header_row", "required_columns", "required_cells"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "header_row": { "type": "integer", "minimum": 1 },
        "required_columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/requiredCell" }
        }
      }
    },
    "workbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "exact_sheet_names", "sheets"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "exact_sheet_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sheets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sheet" }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ids", "forbidden_literals"],
      "properties": {
        "artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_literals": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "artifact_id", "required_artifact_ids"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "required_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
