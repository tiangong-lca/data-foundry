{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.local/foundry/task-start.schema.json",
  "title": "Foundry task-start spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "actor_id",
    "lane",
    "profile_id",
    "target_entities",
    "sources",
    "seed",
    "account_intent",
    "preparation"
  ],
  "properties": {
    "schema": { "const": "tiangong-foundry.task-start.v1" },
    "request_id": { "$ref": "#/$defs/id" },
    "actor_id": { "$ref": "#/$defs/id" },
    "lane": {
      "enum": ["external-dataset-curated-import", "source-evidence-dataset-development"]
    },
    "profile_id": { "$ref": "#/$defs/id" },
    "target_entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "contact",
          "source",
          "support",
          "flow",
          "flowproperty",
          "unitgroup",
          "process",
          "lifecyclemodel"
        ]
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/selection" }
    },
    "seed": { "oneOf": [{ "$ref": "#/$defs/selection" }, { "type": "null" }] },
    "account_intent": {
      "oneOf": [{ "$ref": "#/$defs/accountIntent" }, { "type": "null" }]
    },
    "preparation": {
      "oneOf": [{ "$ref": "#/$defs/cleanupPreparation" }, { "type": "null" }]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "lane": { "const": "source-evidence-dataset-development" } },
        "required": ["lane"]
      },
      "then": { "properties": { "seed": { "$ref": "#/$defs/selection" } } }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": { "path": { "type": "string", "minLength": 1, "maxLength": 4096 } }
    },
    "accountIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_ref", "user_id", "session_reference"],
      "properties": {
        "project_ref": { "type": "string", "pattern": "^[a-z0-9]{20}$" },
        "user_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "session_reference": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        }
      }
    },
    "cleanupPreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "type", "input", "source_input", "output_directory"],
      "properties": {
        "operation": { "const": "dataset-curation-cleanup" },
        "type": {
          "enum": [
            "contact",
            "source",
            "support",
            "flow",
            "flowproperty",
            "unitgroup",
            "process",
            "lifecyclemodel"
          ]
        },
        "input": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_input": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        },
        "output_directory": { "type": "string", "minLength": 1, "maxLength": 4096 }
      }
    }
  }
}
