{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.local/foundry/operation-result.schema.json",
  "title": "Foundry public operation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "status",
    "task_id",
    "artifacts",
    "blockers",
    "next_actions",
    "runtime_identity",
    "permissions"
  ],
  "properties": {
    "schema": { "const": "tiangong-foundry.operation-result.v1" },
    "operation": {
      "enum": [
        "unknown",
        "workspace.init",
        "doctor",
        "task.start",
        "task.status",
        "task.resume",
        "workspace.migrate"
      ]
    },
    "status": {
      "enum": ["ready", "running", "needs_auth", "needs_input", "blocked", "completed", "failed"]
    },
    "task_id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
    "artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [{ "$ref": "#/$defs/fileArtifact" }, { "$ref": "#/$defs/inlineArtifact" }]
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/blocker" }
    },
    "next_actions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "oneOf": [{ "$ref": "#/$defs/humanAction" }, { "$ref": "#/$defs/commandAction" }]
      }
    },
    "runtime_identity": { "oneOf": [{ "type": "object" }, { "type": "null" }] },
    "permissions": { "$ref": "#/$defs/permissions" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["ready", "running", "completed"] } } },
      "then": { "properties": { "blockers": { "type": "array", "maxItems": 0 } } },
      "else": { "properties": { "blockers": { "type": "array", "minItems": 1 } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "path", "bytes", "sha256"],
      "properties": {
        "kind": { "const": "file" },
        "role": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inlineArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "role", "bytes", "sha256", "value"],
      "properties": {
        "kind": { "const": "inline" },
        "role": { "$ref": "#/$defs/id" },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "value": {}
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "scope"],
      "properties": {
        "code": { "$ref": "#/$defs/id" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "scope": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
      }
    },
    "humanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "instructions"],
      "properties": {
        "kind": { "const": "human" },
        "code": { "$ref": "#/$defs/id" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    },
    "commandAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "code", "executable", "argv", "cwd", "purpose", "binding_sha256"],
      "properties": {
        "kind": { "const": "command" },
        "code": { "$ref": "#/$defs/id" },
        "executable": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "argv": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "binding_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "requested_actions", "approval_reference"],
      "properties": {
        "state": { "enum": ["not_required", "required", "granted", "invalid"] },
        "requested_actions": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "approval_reference": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    }
  }
}
