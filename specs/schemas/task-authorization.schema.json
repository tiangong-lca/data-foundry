{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry task authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binding",
    "issued_at_utc",
    "expires_at_utc",
    "remote_state_code",
    "allowed_actions",
    "qa_waivers",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "tiangong-foundry.task-authorization.v1"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "task_id",
        "actor_id",
        "project_ref",
        "user_id",
        "profile_id",
        "profile_sha256",
        "input_scope_sha256"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "project_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "user_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "input_scope_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "issued_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "remote_state_code": {
      "const": 0
    },
    "allowed_actions": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "elementary_flow_write",
          "elementary_flow_create_new",
          "flowproperty_write",
          "unitgroup_write",
          "canonical_support_local_mint"
        ]
      }
    },
    "qa_waivers": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataset_type", "code", "evidence_ids"],
        "properties": {
          "dataset_type": {
            "const": "process"
          },
          "code": {
            "const": "process_material_balance_deviation"
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "reference", "sha256"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": ["user-decision", "source-model"]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
