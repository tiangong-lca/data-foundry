{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiangong-lca.local/foundry/foundry-workspace-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "layout_version",
    "workspace_id",
    "created_at_utc",
    "required_features",
    "migration",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "tiangong-foundry.workspace.v2"
    },
    "layout_version": {
      "const": 2
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "required_features": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "const": "migration-adoption-v1"
          }
        },
        {
          "contains": {
            "const": "registered-tasks-v2"
          }
        }
      ]
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_sha256", "activation_sha256"],
      "properties": {
        "plan_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "activation_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
