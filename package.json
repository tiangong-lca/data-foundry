{
  "name": "@tiangong-lca/foundry",
  "version": "0.1.0",
  "type": "module",
  "description": "Control plane for TianGong LCA external dataset import and TIDAS authoring work.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiangong-lca/data-foundry.git"
  },
  "homepage": "https://github.com/tiangong-lca/data-foundry#readme",
  "bugs": {
    "url": "https://github.com/tiangong-lca/data-foundry/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "types": "./package-dist/scripts/public-api.d.ts",
  "bin": {
    "tiangong-foundry": "./package-dist/scripts/package-entry.js"
  },
  "exports": {
    ".": {
      "types": "./package-dist/scripts/public-api.d.ts",
      "import": "./package-dist/scripts/public-api.js"
    },
    "./runtime": {
      "types": "./package-dist/scripts/public-api.d.ts",
      "import": "./package-dist/scripts/public-api.js"
    }
  },
  "files": [
    "package-dist/",
    "specs/import-profiles.json",
    "specs/schemas/authorization-derivation.schema.json",
    "specs/schemas/execution-context.schema.json",
    "specs/schemas/foundry-facade-request-index.schema.json",
    "specs/schemas/foundry-operation-result.schema.json",
    "specs/schemas/foundry-package-descriptor.schema.json",
    "specs/schemas/foundry-task-start.schema.json",
    "specs/schemas/foundry-workspace-migration-plan.schema.json",
    "specs/schemas/foundry-workspace-migration-transfer-plan.schema.json",
    "specs/schemas/foundry-migration-transfer-receipt.schema.json",
    "specs/schemas/foundry-workspace-migration-pending.schema.json",
    "specs/schemas/foundry-migration-adoption-plan.schema.json",
    "specs/schemas/foundry-migration-activation.schema.json",
    "specs/schemas/foundry-workspace-v2.schema.json",
    "specs/schemas/foundry-runtime-selection.schema.json",
    "specs/schemas/runtime-qualification.schema.json",
    "specs/schemas/task-authorization.schema.json",
    "specs/schemas/tidas-runtime-expectation.schema.json",
    "docs/architecture.md",
    "docs/package-distribution-contract.md",
    "docs/foundry-task-contracts.md",
    "docs/public-runtime-contract.md",
    "docs/runtime-context-contract.md",
    "docs/workspace-migration-contract.md",
    "docs/safety-policy.md",
    "docs/task-authorization-contract.md",
    "docs/import-profiles/bafu/constraints.md",
    "docs/import-profiles/bafu/leaf-process-classification-authoring.md",
    "docs/import-profiles/bafu/profile.md",
    "docs/import-profiles/uslci/constraints.md",
    "docs/import-profiles/uslci/profile.md",
    "docs/uslci-import-runbook.md",
    "docs/import-profiles/worldsteel/constraints.md",
    "docs/import-profiles/worldsteel/import-coverage.md",
    "docs/import-profiles/worldsteel/import-plan.md",
    "docs/import-profiles/worldsteel/profile.md",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "foundry": "node scripts/foundry.ts",
    "init:runtime": "node scripts/foundry.ts init",
    "doctor": "node scripts/foundry.ts doctor",
    "workspace:map": "node scripts/foundry.ts workspace-map",
    "capabilities:list": "node scripts/foundry.ts capabilities-list",
    "profiles:list": "node scripts/foundry.ts profiles-list",
    "tidas:handshake": "node scripts/foundry.ts tidas-handshake",
    "tidas:cutover:audit": "node scripts/check-tidas-cutover.ts",
    "task:route": "node scripts/foundry.ts route-task",
    "task:status": "node scripts/foundry.ts tasks-check",
    "env:check": "node scripts/foundry.ts env-check",
    "account:run": "node scripts/with-lca-account.ts",
    "case:production:contact-draft": "pnpm build && node dist/scripts/cases/production-contact-draft.js",
    "workflow:check": "node scripts/foundry.ts workflow-check",
    "storage:check": "node scripts/foundry.ts storage-check",
    "surface:audit": "node scripts/foundry.ts surface-audit",
    "acceptance:check": "node scripts/foundry.ts acceptance-check",
    "format": "pnpm exec prettier . --write",
    "format:check": "pnpm exec prettier . --check",
    "lint:suppressions": "node scripts/check-lint-suppressions.ts",
    "lint:oxlint": "pnpm exec oxlint --disable-nested-config --type-aware --format=stylish --deny-warnings .",
    "lint:prettier": "pnpm format:check",
    "lint": "pnpm lint:suppressions && pnpm lint:oxlint && pnpm lint:prettier && pnpm typecheck",
    "lint-staged": "pnpm exec lint-staged",
    "typecheck": "pnpm exec tsc --noEmit",
    "build": "node scripts/clean-build-output.ts && pnpm exec tsc -p tsconfig.build.json",
    "package:build": "node scripts/build-foundry-package.ts",
    "package:check": "node scripts/verify-foundry-package.ts",
    "package:pack": "node scripts/pack-foundry-package.ts",
    "release:version": "node scripts/release-version.ts",
    "release:inspect": "node scripts/release-inspect.ts",
    "release:context": "node scripts/release-workflow-context.ts",
    "release:tag": "node scripts/release-create-tag.ts",
    "release:verify-npm": "node scripts/release-verify-npm.ts",
    "skills:list": "pnpm dlx skills@latest list --json",
    "skills:update": "pnpm dlx skills@latest update --project --yes",
    "skills:install:shared": "pnpm dlx skills@latest add ../tiangong-lca-skills --skill external-dataset-curated-import source-evidence-dataset-development dataset-rls-maintenance --agent '*' --yes --full-depth && pnpm dlx skills@latest add https://github.com/tiangong-ai/skills --skill tiangong-kb-sci-search document-granular-decompose --agent '*' --yes --full-depth",
    "skills:source-evidence:use:sci": "pnpm dlx skills@latest use https://github.com/tiangong-ai/skills --skill tiangong-kb-sci-search --full-depth",
    "skills:source-evidence:use:document": "pnpm dlx skills@latest use https://github.com/tiangong-ai/skills --skill document-granular-decompose --full-depth",
    "skills:use": "pnpm dlx skills@latest use",
    "test": "node --test \"test/**/*.test.mts\"",
    "test:unit": "node --test \"test/unit/*.test.mts\"",
    "test:commands": "node --test \"test/commands/*.test.mts\"",
    "test:scenarios": "node --test \"test/scenarios/*.test.mts\"",
    "test:toolchain": "node --test test/unit/toolchain-contract.test.mts",
    "golden:diff": "node scripts/foundry-golden-diff.ts",
    "ncu": "pnpm exec ncu",
    "ncu:update": "pnpm exec ncu -u",
    "dev:hooks": "pnpm exec husky",
    "tasks:list": "node scripts/foundry.ts tasks-list",
    "tasks:check": "node scripts/foundry.ts tasks-check",
    "task:complete": "node scripts/foundry.ts task-complete",
    "install:frozen": "pnpm install --frozen-lockfile",
    "audit:high": "pnpm audit --audit-level high",
    "prepush:gate": "pnpm lint && pnpm test:toolchain && pnpm test && pnpm golden:diff && pnpm surface:audit && pnpm build && pnpm package:build && pnpm package:check && pnpm audit:high"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.24.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "npm-check-updates": "23.1.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "sigstore": "5.0.0",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{ts,mts,cts,tsx}": [
      "node scripts/check-lint-suppressions.ts",
      "oxlint --disable-nested-config --type-aware --format=stylish --deny-warnings"
    ],
    "*.{ts,mts,cts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tiangong-lca/cli": "0.1.10"
  },
  "foundryRuntime": {
    "schema": "tiangong-foundry.runtime-layout.v2",
    "asset_root": ".",
    "source_entry": "scripts/foundry.ts",
    "emitted_entry": "dist/scripts/foundry.js",
    "package_entry": "package-dist/scripts/package-entry.js",
    "package_descriptor": "package-dist/assets/foundry-package-descriptor.json"
  }
}
